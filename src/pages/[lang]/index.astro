---
import "../../styles/global.css";
import DefaultHead from "../../components/DefaultHead.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import type { Language } from "../../i18n/ui";
import { getLangFromUrl, getLanguageStaticPaths, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
const content = t("index");
const metaContent = t("meta");

const mainSections = [
    { id: "experience", section: content.experience, featured: false },
    { id: "activities", section: content.securityActivities, featured: true },
    { id: "work", section: content.selectedWork, featured: true },
    { id: "talks", section: content.talks, featured: false },
    { id: "community", section: content.community, featured: false },
];
const primaryAccountIds = new Set(["x", "github", "zenn", "speakerdeck", "blog"]);
const primaryAccounts = content.accounts.filter((account) => primaryAccountIds.has(account.id));
const secondaryAccounts = content.accounts.filter((account) => !primaryAccountIds.has(account.id));
const labels = lang === "ja"
    ? { navigation: "ページ内ナビゲーション", tags: "技術・キーワード", newTab: "（新しいタブで開きます）", moreLinks: "そのほかのリンク" }
    : { navigation: "Page navigation", tags: "Technologies and keywords", newTab: "(opens in a new tab)", moreLinks: "More links" };

export function getStaticPaths() {
    return getLanguageStaticPaths();
}
---

<html lang={lang}>
    <head>
        <DefaultHead title={metaContent.title} description={metaContent.description} />
    </head>
    <body>
        <main class="portfolio-main">
            <header class="profile-hero">
                <div class="profile-language-switcher">
                    <LanguageSwitcher lang={lang} />
                </div>
                <img
                    class="profile-avatar"
                    src={`${import.meta.env.BASE_URL}tomatokun.png`}
                    alt=""
                    width="220"
                    height="220"
                />
                <div class="min-w-0 flex-1">
                    <p class="profile-handle">@{content.handle}</p>
                    <h1 class="profile-name">{content.name}</h1>
                    <p class="profile-meta">{content.affiliation} · {content.location}</p>
                    <div class="mt-5 space-y-2">
                        {content.introduction.map((paragraph) => <p>{paragraph}</p>)}
                    </div>
                    <div class="profile-links" aria-label={content.accountsTitle}>
                        {primaryAccounts.map((account) => (
                            <a href={account.href} target="_blank" rel="noopener noreferrer">
                                {account.label} <span aria-hidden="true">↗</span>
                                <span class="sr-only">{labels.newTab}</span>
                            </a>
                        ))}
                    </div>
                </div>
            </header>

            <nav class="page-navigation" aria-label={labels.navigation}>
                {mainSections.slice(0, 4).map(({ id, section }) => (
                    <a href={`#${id}`}>{section.heading}</a>
                ))}
            </nav>

            {mainSections.map(({ id, section, featured }) => (
                <section id={id} class="profile-section">
                    <div class="section-heading">
                        <h2>{section.heading}</h2>
                        {section.intro && <p>{section.intro}</p>}
                    </div>
                    <div class:list={[
                        "card-grid",
                        section.items.length === 1 && "card-grid-single",
                        section === content.talks && "card-grid-talks",
                    ]}>
                        {section.items.map((item) => (
                            <article class:list={[
                                "profile-card",
                                featured && "profile-card-featured",
                                section === content.talks && "profile-card-talk",
                            ]}>
                                <div>
                                    <h3>{item.title}</h3>
                                    {item.meta && <p class="card-meta">{item.meta}</p>}
                                </div>
                                <div class="space-y-2">
                                    {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                                </div>
                                {item.tags && (
                                    <ul class="tag-list" aria-label={labels.tags}>
                                        {item.tags.map((tag) => <li>{tag}</li>)}
                                    </ul>
                                )}
                                {item.links && (
                                    <div class="card-links">
                                        {item.links.map((link) => (
                                            <a href={link.href} target="_blank" rel="noopener noreferrer">
                                                {link.label} <span aria-hidden="true">↗</span>
                                                <span class="sr-only">{labels.newTab}</span>
                                            </a>
                                        ))}
                                    </div>
                                )}
                            </article>
                        ))}
                    </div>
                </section>
            ))}

            <section id="skills" class="profile-section">
                <div class="section-heading">
                    <h2>{content.skillsTitle}</h2>
                </div>
                <div class="skills-grid">
                    {content.skillGroups.map((group) => (
                        <article class="profile-card">
                            <h3>{group.title}</h3>
                            <ul class="tag-list mt-3">
                                {group.items.map((item) => <li>{item}</li>)}
                            </ul>
                        </article>
                    ))}
                </div>
            </section>

            <section class="profile-section more-links-section">
                <div class="section-heading">
                    <h2>{labels.moreLinks}</h2>
                </div>
                <div class="profile-links mt-0" aria-label={labels.moreLinks}>
                    {secondaryAccounts.map((account) => (
                        <a href={account.href} target="_blank" rel="noopener noreferrer">
                            {account.label} <span aria-hidden="true">↗</span>
                            <span class="sr-only">{labels.newTab}</span>
                        </a>
                    ))}
                </div>
            </section>

            <section class="profile-section contact-section">
                <div>
                    <h2>Contact</h2>
                    <p class="mt-2">{content.contact}</p>
                </div>
            </section>
        </main>
    </body>
</html>
