---
import "../../styles/global.css";
import DefaultHead from "../../components/DefaultHead.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import type { Language, ProfileSection } from "../../i18n/ui";
import { getLangFromUrl, getLanguageStaticPaths, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
const content = t("index");
const metaContent = t("meta");

const mainSections: ProfileSection[] = [
    content.experience,
    content.securityActivities,
    content.selectedWork,
    content.talks,
    content.community,
];

export function getStaticPaths() {
    return getLanguageStaticPaths();
}
---

<html lang={lang}>
    <head>
        <DefaultHead title={metaContent.title} description={metaContent.description} />
    </head>
    <body>
        <main class="container">
            <header class="profile-hero">
                <div class="profile-language-switcher">
                    <LanguageSwitcher lang={lang} />
                </div>
                <img
                    class="profile-avatar"
                    src={`${import.meta.env.BASE_URL}tomatokun.png`}
                    alt=""
                    width="220"
                    height="220"
                />
                <div class="min-w-0 flex-1">
                    <p class="profile-handle">@{content.handle}</p>
                    <h1 class="profile-name">{content.name}</h1>
                    <p class="profile-meta">{content.affiliation} · {content.location}</p>
                    <div class="mt-5 space-y-2">
                        {content.introduction.map((paragraph) => <p>{paragraph}</p>)}
                    </div>
                    <div class="profile-links" aria-label={content.accountsTitle}>
                        {content.accounts.map((account) => (
                            <a href={account.href} target="_blank" rel="noopener noreferrer">
                                {account.label}
                            </a>
                        ))}
                    </div>
                </div>
            </header>

            {mainSections.map((section) => (
                <section class="profile-section">
                    <div class="section-heading">
                        <h2>{section.heading}</h2>
                        {section.intro && <p>{section.intro}</p>}
                    </div>
                    <div class:list={["card-grid", section === content.talks && "card-grid-talks"]}>
                        {section.items.map((item) => (
                            <article class="profile-card">
                                <div>
                                    <h3>{item.title}</h3>
                                    {item.meta && <p class="card-meta">{item.meta}</p>}
                                </div>
                                <div class="space-y-2">
                                    {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                                </div>
                                {item.tags && (
                                    <ul class="tag-list" aria-label="Technologies">
                                        {item.tags.map((tag) => <li>{tag}</li>)}
                                    </ul>
                                )}
                                {item.links && (
                                    <div class="card-links">
                                        {item.links.map((link) => (
                                            <a href={link.href} target="_blank" rel="noopener noreferrer">
                                                {link.label} <span aria-hidden="true">↗</span>
                                            </a>
                                        ))}
                                    </div>
                                )}
                            </article>
                        ))}
                    </div>
                </section>
            ))}

            <section class="profile-section">
                <div class="section-heading">
                    <h2>{content.skillsTitle}</h2>
                </div>
                <div class="skills-grid">
                    {content.skillGroups.map((group) => (
                        <article class="profile-card">
                            <h3>{group.title}</h3>
                            <ul class="tag-list mt-3">
                                {group.items.map((item) => <li>{item}</li>)}
                            </ul>
                        </article>
                    ))}
                </div>
            </section>

            <section class="profile-section contact-section">
                <div>
                    <h2>Contact</h2>
                    <p class="mt-2">{content.contact}</p>
                </div>
            </section>
        </main>
    </body>
</html>
